# Copy to .env. Generate different random values; never commit .env.
# Use letters/digits for the PostgreSQL password to keep the DSN unambiguous.
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
APP_TOKEN=replace_with_at_least_32_random_characters
IMAGE_TAG=latest
PORT=8080
BIND_ADDRESS=127.0.0.1
ALLOW_PRIVATE_ENDPOINTS=false
# Only for a trusted Fake-IP DNS proxy. Comma-separated exact hostnames.
TRUSTED_EGRESS_HOSTS=
