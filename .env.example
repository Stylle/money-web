# 最简 compose.yaml 可以直接填写口令，无需 .env。
# 使用环境变量时，把 compose.yaml 的 APP_TOKEN 改为 ${APP_TOKEN:?Set APP_TOKEN}。
APP_TOKEN=replace_with_at_least_32_random_characters
# 可选环境变量需显式加到 Compose environment 中，仅写在 .env 不会自动传入容器。
ALLOW_PRIVATE_ENDPOINTS=false
TRUSTED_EGRESS_HOSTS=
# 可选代理，需在 Compose environment 显式引用；7890 是 HTTP/Mixed 端口示例。
# NAS 宿主机代理还需 extra_hosts: ["host.docker.internal:host-gateway"]。
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal
